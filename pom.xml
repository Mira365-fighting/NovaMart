<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!--版本管理-->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>
    <groupId>com.example</groupId>
    <artifactId>NovaMart</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>NovaMart</name>
    <description/>
    <properties>
        <java.version>17</java.version>
        <!--MyBatis-Plus 与 PageHelper 版本统一在这里管理-->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <pagehelper.version>6.1.0</pagehelper.version>
        <java-jwt.version>4.4.0</java-jwt.version>
    </properties>
    <dependencies>
        <!--SpringMVC 内嵌 Tomcat RESTful API 控制器 请求映射 拦截器 异常处理-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!--
            Spring Security：本版用它做「前后台权限分离」——
            JwtAuthenticationFilter 负责认证，@PreAuthorize("hasRole('ADMIN')") 负责鉴权。-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!--
            Redis：本版重新引入，干两件事——
            1) 退出登录把 Token 的 jti 写进黑名单（TTL = Token 剩余有效期，到期自动清理）；
            2) 商品详情缓存（含空值缓存 + 随机 TTL）。
            所有 Redis 调用点都做了降级：Redis 挂了应用照常可用，只是没有缓存和吊销能力。-->
        <!-- redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!--参数校验 DTO上的 @NotNull @NotBlank @Pattern @Size-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
            MyBatis-Plus：BaseMapper 自带单表 CRUD，条件构造器替代大量 XML，省掉手写 SQL。
            引入后不能再引 mybatis-spring-boot-starter，否则两套自动配置会打架。-->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>3.5.17</version>
        </dependency>
        <!--
            PageHelper：只引核心包，由 MyBatisPlusConfiguration 手动注册 PageInterceptor。
            不引 pagehelper-spring-boot-starter，因为它会把 mybatis-spring-boot-starter 一起带进来。
        -->
        <dependency>
            <groupId>com.github.pagehelper</groupId>
            <artifactId>pagehelper</artifactId>
            <version>${pagehelper.version}</version>
        </dependency>
        <!--热部署-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <!--MySQL 驱动-->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--lombok @Data 省掉 getter/setter-->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!--JWT：登录签发 accessToken(2h) + refreshToken(7d)；退出时按 jti 拉黑-->
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
            <version>${java-jwt.version}</version>
        </dependency>
        <!--BCrypt 密码加密与校验（starter 已带，显式声明表明它是主动使用的依赖）-->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!--测试-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
